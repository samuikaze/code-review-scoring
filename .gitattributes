# bash / zsh / awk 只能讀 LF 換行；在 core.autocrlf=true 的 Windows 上也要維持 LF
*.sh   text eol=lf
*.zsh  text eol=lf
*.awk  text eol=lf
*.tsv  text eol=lf
*.ini  text eol=lf
*.md   text eol=lf
# 測試的預期輸出，compare.sh 以 LF 比對
tests/**/expected.txt  text eol=lf
# 測試用的 diff 與 findings 也以 LF 保存，三種 shell 讀到相同的內容
tests/**/*.diff  text eol=lf
tests/**/*.txt   text eol=lf

# PowerShell 腳本以 UTF-8 with BOM 儲存，換行交給 git 依平台處理
*.ps1  text
